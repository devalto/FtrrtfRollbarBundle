{
    "name": "ftrrtf/rollbar-bundle",
    "description": "Symfony bundle for rollbar.com",
    "keywords": [
        "rollbar",
        "errors",
        "symfony"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Valeriy Rabievskiy",
            "email": "dev@ftrrtf.com"
        }
    ],
    "require": {
        "php": ">=7.1.3",
        "symfony/framework-bundle": "^4.4",
        "symfony/security-bundle": "^4.4",
        "symfony/expression-language": "^4.4",
        "ftrrtf/rollbar-notifier": "dev-symfony4",
        "symfony/dependency-injection": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5",
        "phpspec/phpspec": "^5.1",
        "symfony/twig-bundle": "^4.4",
        "mikey179/vfsstream": "^1.6",
        "twig/twig": "^2.16 || ^3.0"
    },
    "suggest": {
        "symfony/twig-bundle": "Enable rollbarjs twig helpers"
    },
    "autoload": {
        "psr-4": {
            "Ftrrtf\\RollbarBundle\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/devalto/rollbar-notifier",
            "no-api": true
        }
    ],
    "config": {
        "platform": {
            "php": "7.2.34"
        },
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
